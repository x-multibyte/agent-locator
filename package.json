{
  "name": "agent-locator",
  "version": "0.1.0",
  "description": "Detect installed AI coding agents and manage skills with symlink and copy modes via TypeScript (Ink) + Rust (napi-rs).",
  "type": "module",
  "bin": {
    "agent-locator": "./dist/index.js",
    "agloc": "./dist/index.js"
  },
  "files": [
    "dist",
    "agent-locator.node",
    "agent-locator.*.node",
    "agent-tools.json",
    "agent-tools-schema.json",
    "agent-tools-scan-result-schema.json"
  ],
  "scripts": {
    "build:rust": "cargo build --release && node scripts/copy-native.mjs",
    "build:ts": "tsc",
    "build": "npm run build:rust && npm run build:ts",
    "start": "node dist/index.js",
    "test": "cargo test && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "citty": "^0.1.6",
    "ink": "^5.0.1",
    "picocolors": "^1.1.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
